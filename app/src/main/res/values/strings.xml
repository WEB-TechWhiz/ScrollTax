<resources>
    <string name="app_name">Scroll Tax</string>
    <string name="app_tagline">Catch impulse opens, break doomscrolling</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Break the Scroll Loop</string>
    <string name="onboarding_welcome_desc">Scroll Tax helps you catch impulse opens, repeated social app checks, and late-night doomscrolling with lightweight nudges and a playful monkey.</string>
    <string name="onboarding_permission_title">We Need Usage Access</string>
    <string name="onboarding_permission_desc">To detect when you open apps and help you stay mindful, we need access to your app usage statistics. We never read your messages, content, or personal data.</string>
    <string name="onboarding_app_select_title">Choose Apps to Track</string>
    <string name="onboarding_app_select_desc">Select the apps that tend to trap you in endless scrolling. We will watch for impulse opens and repeated checks.</string>
    <string name="onboarding_sensitivity_title">Set Your Sensitivity</string>
    <string name="onboarding_sensitivity_desc">How strict should we be? Higher sensitivity means more frequent interventions.</string>
    <string name="onboarding_monkey_title">Meet Your Monkey</string>
    <string name="onboarding_monkey_desc">Choose your monkey personality. They will appear when you are stuck in a scroll loop.</string>
    <string name="onboarding_success_title">You are All Set!</string>
    <string name="onboarding_success_desc">Your monkey is ready to help. Expect some interventions today as you learn your patterns. You can always adjust settings later.</string>

